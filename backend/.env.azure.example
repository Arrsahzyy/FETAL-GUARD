ENVIRONMENT=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://<api_role>:<password>@<host>:5432/fetalguard_staging
# Owner role used only to run migrations; must NOT be the runtime API role above.
ALEMBIC_DATABASE_URI=postgresql+psycopg://<owner_role>:<password>@<host>:5432/fetalguard_staging
AUTO_CREATE_DB=false
BACKEND_CORS_ORIGINS=["https://<your-static-web-app>.azurestaticapps.net"]
# Required. TrustedHostMiddleware rejects every request whose Host header is not
# listed here, so this must name the real App Service hostname or the API starts
# successfully and then answers 400 to all traffic.
TRUSTED_HOSTS=["<your-backend-app>.azurewebsites.net"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Required in production. Every device must be provisioned a signing key via
# POST /devices/{id}/signing-key and reflashed before it can upload telemetry.
REQUIRE_DEVICE_PACKET_SIGNATURE=true
AI_PIPELINE_MODE=disabled
# Keep disabled until a registered artifact and isolated worker are ready.
AI_ACTIVE_MODEL_VERSION_ID=
AI_WINDOW_SECONDS=60
AI_WINDOW_STRIDE_SECONDS=15
AI_LATE_ARRIVAL_GRACE_SECONDS=10
AI_MIN_VALID_RATIO=0.8
AI_MAX_JOB_ATTEMPTS=3
AI_JOB_LEASE_SECONDS=120
FG_ADMIN_EMAIL=admin@fetalguard.id
FG_ADMIN_PASSWORD=replace-with-temporary-bootstrap-password
