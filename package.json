{
  "name": "fetal-guard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-local.ps1",
    "generate:android:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-android-icons.ps1",
    "local": "node scripts/local-server.mjs",
    "localserver": "node scripts/local-server.mjs",
    "local:staff": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-local-staff.ps1",
    "local:device": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-local-mobile-device.ps1",
    "local:test": "node --test scripts/local-server.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:frontend": "node --test src/hooks/useBluetooth.test.js src/services/apiRuntimeConfig.test.js src/services/authSessionEpoch.test.js src/services/patientPreferences.test.js src/services/patientTelemetryQueue.test.js src/services/realtimeEventPoller.test.js src/services/webBluetoothClient.test.js src/utils/aiAnalysisModels.test.js src/utils/clinicianModels.test.js src/utils/patientHomeSummary.test.js src/utils/patientLiveReadings.test.js"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor/android": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/status-bar": "^8.0.1",
    "axios": "^1.18.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
